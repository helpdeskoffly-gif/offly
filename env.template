# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL (from your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (from your Supabase dashboard)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: OpenAI API Key (for AI-powered features)
# Get this from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Development Notes:
# 1. Never commit .env.local to version control
# 2. The ANON key is safe to use in client-side code
# 3. Get your Supabase credentials from: Settings → API in your Supabase dashboard
# 4. Make sure to set the same variables in your production environment
